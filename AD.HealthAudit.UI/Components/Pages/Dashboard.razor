@page "/dashboard"

@using AD.HealthAudit.UI.DTOs
@using AD.HealthAudit.UI.Services

@inject DashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Active Directory Health</h1>
            <p>Overview of your Active Directory environment</p>
        </div>
    </div>

    @if (dashboard is null)
    {
        <div class="loading">
            <p>Loading dashboard...</p>
        </div>
    }
    else
    {
        <div class="stats-grid">

            <!-- Users -->
            <div class="stat-card">
                <div class="stat-card-header">
                    <span>Users</span>
                    <span class="stat-icon">👤</span>
                </div>

                <div class="stat-number">
                    @dashboard.NumberOfUsers
                </div>

                <div class="stat-details">
                    <span class="success">
                        @dashboard.EnabledUsers Enabled
                    </span>

                    <span class="danger">
                        @dashboard.DisabledUsers Disabled
                    </span>
                </div>
            </div>


            <!-- Computers -->
            <div class="stat-card">
                <div class="stat-card-header">
                    <span>Computers</span>
                    <span class="stat-icon">💻</span>
                </div>

                <div class="stat-number">
                    @dashboard.NumberOfComputers
                </div>

                <div class="stat-details">
                    <span class="success">
                        @dashboard.EnabledComputers Enabled
                    </span>

                    <span class="danger">
                        @dashboard.DisabledComputers Disabled
                    </span>
                </div>
            </div>


            <!-- Groups -->
            <div class="stat-card">
                <div class="stat-card-header">
                    <span>Groups</span>
                    <span class="stat-icon">👥</span>
                </div>

                <div class="stat-number">
                    @dashboard.NumberOfGroups
                </div>

                <div class="stat-details">
                    Active Directory Groups
                </div>
            </div>


            <!-- Expired Passwords -->
            <div class="stat-card">
                <div class="stat-card-header">
                    <span>Expired Passwords</span>
                    <span class="stat-icon">🔐</span>
                </div>

                <div class="stat-number">
                    @dashboard.ExpiredPasswords
                </div>

                <div class="stat-details">
                    @if (dashboard.ExpiredPasswords == 0)
                    {
                        <span class="success">
                            ✓ No expired passwords
                        </span>
                    }
                    else
                    {
                        <span class="warning">
                            ⚠ Users require attention
                        </span>
                    }
                </div>
            </div>

        </div>
    }

</div>

@code {

    private DashboardMainDTO? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await DashboardService.GetMainDashboardAsync();
    }
}